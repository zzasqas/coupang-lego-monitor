# ── 資料庫（Railway PostgreSQL）────────────────────
# Railway 會自動注入；本機開發可填本機 / Railway 外部連線字串
DATABASE_URL=
# 用外部 proxy（含 SSL）連 Railway DB 時設為 true；Railway 內網不需要
PGSSL=false

# ── 通知設定 ────────────────────────────────────
# 選擇通知頻道：discord（推薦）/ telegram / line-messaging
NOTIFY_CHANNEL=discord

# Discord Webhook（推薦，用於「發送警報」，單向）
# 設定：頻道齒輪 → 整合 → Webhook → 新增 → 複製 URL
# Webhook URL 本身就綁定一個頻道，自然只往該頻道發訊息
DISCORD_WEBHOOK_URL=

# ── Discord Bot（用於「接收指令」增減品項 / 設目標價 / 查價）──────
# Developer Portal → 你的 App → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Developer Portal → General Information → Application ID
DISCORD_APP_ID=
# 你的伺服器 ID（開發者模式 → 右鍵伺服器 → 複製 ID）；填了指令秒生效
DISCORD_GUILD_ID=

# Telegram Bot（備用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Messaging API（備用）
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# ── Coupang 帳號（Phase 3 登入用，目前不需要）──────
COUPANG_EMAIL=
COUPANG_PASSWORD=

# ── 執行設定 ────────────────────────────────────
HEADLESS=true
DRY_RUN=false
# 時區（影響排程觸發時間與日期顯示）
TZ=Asia/Taipei
