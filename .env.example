# ── 通知設定（擇一）──────────────────────────────
# 選擇通知頻道：telegram 或 line-messaging
NOTIFY_CHANNEL=telegram

# Telegram Bot（推薦）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Messaging API（備用）
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# ── Coupang 帳號（Phase 3 登入用，目前不需要）──────
COUPANG_EMAIL=
COUPANG_PASSWORD=

# ── 執行設定 ────────────────────────────────────
HEADLESS=true
DRY_RUN=false
