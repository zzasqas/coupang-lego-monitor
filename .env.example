# ── 通知設定 ────────────────────────────────────
# 選擇通知頻道：discord（推薦）/ telegram / line-messaging
NOTIFY_CHANNEL=discord

# Discord Webhook（推薦）
# 設定：頻道齒輪 → 整合 → Webhook → 新增 → 複製 URL
# Webhook URL 本身就綁定一個頻道，自然只往該頻道發訊息
DISCORD_WEBHOOK_URL=

# Telegram Bot（備用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE Messaging API（備用）
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# ── Coupang 帳號（Phase 3 登入用，目前不需要）──────
COUPANG_EMAIL=
COUPANG_PASSWORD=

# ── 執行設定 ────────────────────────────────────
HEADLESS=true
DRY_RUN=false
